# Copy this to .env and fill in your values.
# Never commit .env to git — it is already in .gitignore.

# Flask secret key — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Google OAuth 2.0 credentials (from Google Cloud Console → APIs & Services → Credentials)
CLIENT_ID=your-client-id.apps.googleusercontent.com
CLIENT_SECRET=your-client-secret

# The full public URL of your /auth/callback route.
# Local dev:   http://localhost:5000/auth/callback
# Railway:     https://your-app.up.railway.app/auth/callback
# Must also be added to "Authorized redirect URIs" in Google Cloud Console.
REDIRECT_URI=http://localhost:5000/auth/callback

# Set to 1 for local HTTP development only.
# Remove this line (or set to 0) when deployed to Railway.
OAUTHLIB_INSECURE_TRANSPORT=1
